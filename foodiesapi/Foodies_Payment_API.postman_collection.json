        {
          "name": "Create Order - bKash Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderedItems\": [\n    {\n      \"foodId\": \"food123\",\n      \"foodName\": \"Chicken Burger\",\n      \"quantity\": 2,\n      \"price\": 350\n    },\n    {\n      \"foodId\": \"food124\",\n      \"foodName\": \"French Fries\",\n      \"quantity\": 1,\n      \"price\": 150\n    }\n  ],\n  \"userAddress\": \"House 23, Road 5, Dhanmondi, Dhaka-1205\",\n  \"amount\": 850,\n  \"phoneNumber\": \"01712345678\",\n  \"email\": \"customer@example.com\",\n  \"customerName\": \"Ahmed Hassan\",\n  \"paymentGateway\": \"SSLCOMMERZ\",\n  \"paymentMethod\": \"bkash\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/orders/create",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "orders", "create"]
            },
            "description": "Create an order with bKash payment method"
          }
        },
