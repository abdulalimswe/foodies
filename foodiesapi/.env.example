# Environment Variables Template for Foodies API
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real credentials to version control

# ================================
# DATABASE
# ================================
MONGODB_URI=mongodb://localhost:27017/foodies
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/foodies?retryWrites=true&w=majority

# ================================
# AWS S3 (for image uploads)
# ================================
AWS_ACCESS_KEY=your-aws-access-key-here
AWS_SECRET_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ================================
# JWT AUTHENTICATION
# ================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-256-bits
JWT_EXPIRATION_TIME=86400000

# ================================
# RAZORPAY (International Payments)
# ================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ================================
# SSLCOMMERZ (Bangladesh Payments)
# ================================
# Supports: bKash, Rocket, Nagad, Visa, Mastercard, etc.
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password

# ================================
# APPLICATION
# ================================
# Local: http://localhost:8080
# Production: https://yourdomain.com
APP_URL=http://localhost:8080
PORT=8080

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO
